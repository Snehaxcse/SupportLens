# Public browser configuration only. Copy to ignored .env.local.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_PUBLIC_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_WITH_PROJECT_ID
# Optional for email/password-only authentication; use registered values if supplied.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Never put Admin credentials, DB URLs or test-account passwords here.
