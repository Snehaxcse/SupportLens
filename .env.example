# Placeholders only. Copy to ignored .env locally; never paste credentials in chat.
ENVIRONMENT=development
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST/SupportLens_dev?sslmode=verify-full
TEST_DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST/SupportLens_test?sslmode=verify-full
# Supply direct (non-pooler) endpoints for migrations when application URLs are pooled.
MIGRATION_DATABASE_URL=
TEST_MIGRATION_DATABASE_URL=
EXPECTED_DEV_DATABASE_NAME=SupportLens_dev
EXPECTED_TEST_DATABASE_NAME=SupportLens_test
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=10000
# libpq system trust or an absolute path to a locally trusted CA bundle.
DB_SSL_ROOT_CERT=system
# Integration tests are disabled unless explicitly enabled locally.
SUPPORTLENS_RUN_DB_TESTS=0
# M2-B: explicit Firebase project ID (not the Firebase Web API key).
FIREBASE_PROJECT_ID=
# Optional absolute path to an existing private service-account JSON file.
# Leave blank to use Google's Application Default Credentials discovery.
GOOGLE_APPLICATION_CREDENTIALS=
# Exact browser origins as a JSON array. Empty rejects all cross-origin access.
CORS_ALLOWED_ORIGINS=[]
