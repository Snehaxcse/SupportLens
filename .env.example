# Placeholders only. Copy to ignored .env locally; never paste credentials in chat.
ENVIRONMENT=development
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST/SupportLens_dev?sslmode=verify-full
TEST_DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST/SupportLens_test?sslmode=verify-full
# Supply direct (non-pooler) endpoints for migrations when application URLs are pooled.
MIGRATION_DATABASE_URL=
TEST_MIGRATION_DATABASE_URL=
EXPECTED_DEV_DATABASE_NAME=SupportLens_dev
EXPECTED_TEST_DATABASE_NAME=SupportLens_test
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=10000
# libpq system trust or an absolute path to a locally trusted CA bundle.
DB_SSL_ROOT_CERT=system
# Integration tests are disabled unless explicitly enabled locally.
SUPPORTLENS_RUN_DB_TESTS=0
# M2-B: explicit Firebase project ID (not the Firebase Web API key).
FIREBASE_PROJECT_ID=
# Optional absolute path to an existing private service-account JSON file.
# Leave blank to use Google's Application Default Credentials discovery.
GOOGLE_APPLICATION_CREDENTIALS=
# Exact browser origins as a JSON array. Empty rejects all cross-origin access.
CORS_ALLOWED_ORIGINS=[]
# M4-A: advisory-only classification. No client-selected artifact or model path.
CLASSIFICATION_ENABLED=true
CLASSIFICATION_WORKER_ENABLED=true
# Unvalidated advisory flag only; every prediction still requires human review.
CLASSIFICATION_LOW_SCORE_THRESHOLD=0.5
CLASSIFICATION_POLL_SECONDS=30
CLASSIFICATION_LEASE_SECONDS=300
CLASSIFICATION_MAX_EXECUTIONS=3
CLASSIFICATION_RETRY_COOLDOWN_SECONDS=60
CLASSIFICATION_RETRY_LIMIT_PER_MINUTE=10
# M4-B: local CPU embeddings and durable publication indexing.
KNOWLEDGE_WORKER_ENABLED=true
KNOWLEDGE_EMBEDDINGS_ENABLED=true
KNOWLEDGE_POLL_SECONDS=30
# Only enable in an isolated synthetic verification process.
KNOWLEDGE_ALLOW_SYNTHETIC=false
# Optional. Use a Gemini Developer API Free Tier project with billing disabled.
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_DAILY_LIMIT=8
GEMINI_TIMEOUT_SECONDS=20
# Exact, owner-approved fictional ticket for local verification.
GEMINI_SYNTHETIC_TICKET_ID=
# Enable only after policy, source rights and customer data handling are reviewed.
GEMINI_ALLOW_REVIEWED_CONTEXT=false
DRAFT_POLL_SECONDS=30
